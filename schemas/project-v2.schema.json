{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://image-studio.local/schemas/project-v2.schema.json",
  "title": "ProjectDocumentV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "metadata", "canvas", "assets", "rootLayerIds", "layers", "exportSettings"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "createdAt", "updatedAt", "appVersion"],
      "properties": {
        "name": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "appVersion": { "type": "string" }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background", "colorSpace"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "background": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "transparent" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "color"],
              "properties": {
                "kind": { "const": "solid" },
                "color": { "type": "string" }
              }
            }
          ]
        },
        "colorSpace": { "const": "srgb" }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/assetManifestEntry" }
    },
    "rootLayerIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "layers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/layer" }
    },
    "exportSettings": { "$ref": "#/$defs/exportSettings" },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "assetManifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "mimeType", "checksumSha256", "byteLength", "storageKey"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["image", "mask", "depth", "font"] },
        "mimeType": { "type": "string" },
        "checksumSha256": { "type": "string" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "storageKey": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceAssetIds", "operation", "parametersHash", "createdAt"],
          "properties": {
            "sourceAssetIds": { "type": "array", "items": { "type": "string" } },
            "operation": { "type": "string" },
            "parametersHash": { "type": "string" },
            "modelId": { "type": "string" },
            "modelRevision": { "type": "string" },
            "createdAt": { "type": "string" }
          }
        }
      }
    },
    "transform2D": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "scaleX", "scaleY", "rotationDeg", "anchorX", "anchorY"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "scaleX": { "type": "number" },
        "scaleY": { "type": "number" },
        "rotationDeg": { "type": "number" },
        "anchorX": { "type": "number" },
        "anchorY": { "type": "number" },
        "flipX": { "type": "boolean" },
        "flipY": { "type": "boolean" }
      }
    },
    "effectNode": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "enabled", "version", "params"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "enabled": { "type": "boolean" },
        "version": { "type": "integer", "minimum": 1 },
        "params": { "type": "object" }
      }
    },
    "visualLayerCommon": {
      "type": "object",
      "required": ["id", "name", "visible", "locked", "opacity", "blendMode", "transform", "effects"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blendMode": { "type": "string" },
        "transform": { "$ref": "#/$defs/transform2D" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effectNode" } }
      }
    },
    "layer": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/visualLayerCommon" },
            {
              "type": "object",
              "required": ["type", "assetId"],
              "properties": {
                "type": { "const": "raster" },
                "assetId": { "type": "string", "minLength": 1 },
                "maskAssetId": { "type": "string" },
                "rollbackAssetId": { "type": "string" },
                "mediaMapping": { "type": "object" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/visualLayerCommon" },
            {
              "type": "object",
              "required": ["type", "text", "style"],
              "properties": {
                "type": { "const": "text" },
                "text": { "type": "string" },
                "style": { "type": "object" },
                "fontAssetId": { "type": "string" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/visualLayerCommon" },
            {
              "type": "object",
              "required": ["type", "childIds"],
              "properties": {
                "type": { "const": "group" },
                "childIds": { "type": "array", "items": { "type": "string" } }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/visualLayerCommon" },
            {
              "type": "object",
              "required": ["type", "scope"],
              "properties": {
                "type": { "const": "adjustment" },
                "scope": { "type": "string", "enum": ["below", "group"] }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "name", "visible", "locked", "region", "fill", "secure"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "type": { "const": "redaction" },
            "name": { "type": "string" },
            "visible": { "type": "boolean" },
            "locked": { "type": "boolean" },
            "region": { "type": "object" },
            "fill": { "type": "string" },
            "secure": { "const": true }
          }
        }
      ]
    },
    "exportSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "reducePalette", "transparent"],
      "properties": {
        "format": { "const": "png" },
        "reducePalette": { "type": "boolean" },
        "transparent": { "type": "boolean" }
      }
    }
  }
}
