# Image Studio — optional environment

# API
IMAGE_STUDIO_API_HOST=127.0.0.1
IMAGE_STUDIO_API_PORT=8000
IMAGE_STUDIO_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Job queue / memory guard (AI and upscale)
# IMAGE_STUDIO_AI_MAX_CONCURRENT=1
# IMAGE_STUDIO_AI_QUEUE_WAIT_S=120
# IMAGE_STUDIO_MIN_FREE_RAM_GIB=3.0
# IMAGE_STUDIO_MIN_FREE_VRAM_GIB=0.35
# IMAGE_STUDIO_UNLOAD_MODELS=1
# IMAGE_STUDIO_RAM_RESERVE_UPSCALE_GIB=2.0
# Set IMAGE_STUDIO_UNLOAD_MODELS=0 to keep models warm (faster repeats, more RAM)

# Vite → API proxy
VITE_API_PROXY=http://127.0.0.1:8000

# Persistence (optional)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/image_studio

# AI models — runners live in src/image_studio/ai/
# Install: pip install -r requirements-ai.txt && python scripts/setup_ai_models.py
# IMAGE_STUDIO_MODELS_DIR=models
# IMAGE_STUDIO_THIRD_PARTY=third_party
# IMAGE_STUDIO_TORCH_DEVICE=cuda   # or cpu / mps
# Setup selects CUDA 12.6 for legacy NVIDIA GPUs and CUDA 12.8 for newer GPUs.
# Override only when a different official PyTorch wheel channel is required:
# IMAGE_STUDIO_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

# Prompt selection is fixed in the backend:
#   models/sam2/sam2.1_hiera_large.pt
#   models/groundingdino/groundingdino_swinb_cogcoor.pth
#   models/matte/birefnet-general.onnx
# Point cut uses the same fixed SAM checkpoint directly.

# Real-ESRGAN uses only models/realesrgan/RealESRGAN_x2plus.pth and
# models/realesrgan/RealESRGAN_x4plus.pth.
# REALESRGAN_TILE=0
